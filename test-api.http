# PHASE 15: BILLING & PAYMENTS (Endpoints 66-80)
###############################################

### 66. Create Checkout Session
POST {{baseUrl}}/billing/checkout
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "planId": "plan-uuid-here",
  "successUrl": "http://localhost:3000/success",
  "cancelUrl": "http://localhost:3000/cancel"
}

### 67. Create Customer Portal Session
POST {{baseUrl}}/billing/portal
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "returnUrl": "http://localhost:3000/billing"
}

### 68. Get Current Subscription
GET {{baseUrl}}/billing/subscription
Authorization: Bearer {{token}}

### 69. Cancel Subscription (at period end)
POST {{baseUrl}}/billing/subscription/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "immediate": false
}

### 70. Cancel Subscription (immediately)
POST {{baseUrl}}/billing/subscription/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "immediate": true
}

### 71. Resume Cancelled Subscription
POST {{baseUrl}}/billing/subscription/resume
Authorization: Bearer {{token}}

### 72. Change Subscription Plan
POST {{baseUrl}}/billing/subscription/change
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newPlanId": "new-plan-uuid-here"
}

### 73. Get Invoices
GET {{baseUrl}}/billing/invoices?page=1&limit=10
Authorization: Bearer {{token}}

### 74. Get Upcoming Invoice
GET {{baseUrl}}/billing/invoices/upcoming
Authorization: Bearer {{token}}

### 75. Get Payment Methods
GET {{baseUrl}}/billing/payment-methods
Authorization: Bearer {{token}}

### 76. Set Default Payment Method
PUT {{baseUrl}}/billing/payment-methods/pm_1234567890/default
Authorization: Bearer {{token}}

### 77. Delete Payment Method
DELETE {{baseUrl}}/billing/payment-methods/pm_1234567890
Authorization: Bearer {{token}}

### 78. Get Transactions
GET {{baseUrl}}/billing/transactions?page=1&limit=10
Authorization: Bearer {{token}}

### 79. Admin - Sync Plans to Stripe
POST {{baseUrl}}/billing/admin/sync-plans
Authorization: Bearer {{token}}

### 80. Admin - Get Billing Overview
GET {{baseUrl}}/billing/admin/overview
Authorization: Bearer {{token}}

